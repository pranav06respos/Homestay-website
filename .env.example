# Neel Kamal Homestay Env Configurations

# Local Dev Port for the Express API Server
PORT=8080

# Database URL for PostgreSQL (Drizzle migrations + Server)
DATABASE_URL=postgresql://username:password@hostname:port/dbname

# Session Secret for Express Session signing
SESSION_SECRET=your_session_signing_secret_here

# Admin Dashboard Password
ADMIN_PASSWORD=your_admin_password_here
