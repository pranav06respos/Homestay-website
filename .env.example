# Neel Kamal Homestay Env Configurations

# Local Dev Port for the Express API Server
PORT=8080

# Database URL for PostgreSQL (Drizzle migrations + Server)
DATABASE_URL=postgresql://user:password@localhost:5432/homestay

# Session Secret for Express Session signing
SESSION_SECRET=your_super_secret_session_secret_key

# Admin Dashboard Password (defaults to admin1234 if not configured)
ADMIN_PASSWORD=admin1234
